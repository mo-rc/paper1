index 0000000..f85d5b9
--- /dev/null
+++ b/src/ub_rl/baselines.py
@@ -0,0 +1,130 @@
+"""Stage 1 baselines I (patch P7): enumeration, ordered scan, heuristic iteration, random search.
+
+All methods share the verified checker over the mass-ordered catalogue C, the same contexts and the same
+objective (spec section 7: minimum mass, ties by smaller depth, then catalogue order). All return a section
+index into C or -1 (abstain).
+
+Cost accounting (spec section 10): one checker call is one section evaluation. A vectorised evaluation of k
+sections therefore counts as k calls; the CountingChecker wrapper measures the calls actually made, and every
+method reports that measured number (its own arithmetic is never trusted). Per spec section 9, the end-to-end
+procedure adds one verification call when a design is output and none when the method abstains; that call is
+reported separately and is not part of the search calls.
+
+Method definitions (spec section 9):
+  enumeration     every section of C evaluated; the lightest feasible section is the exact reference optimum
+  ordered scan    sections evaluated in mass order; the first feasible section is the optimum (exact)
+  heuristic       trial section = first section in mass order with Wpl >= M_Ed / 355 (w = superimposed
+                  factored UDL, fy = 355), step up in mass order until feasible, then down while the
+                  next-lighter section stays feasible (conventional manual design)
+  random search   a fixed number (budget) of distinct sections drawn uniformly without replacement; the
+                  lightest feasible among them is output. Budget |C| draws the whole catalogue, so it equals
+                  enumeration; seeds then do not matter (recorded, not assumed silently).
+Feasibility is not monotone in mass order, so the heuristic and random search can return a feasible section
+heavier than the enumeration optimum; the gap is a result, not an assumption.
+"""
+from dataclasses import dataclass
+
+import numpy as np
+
+RANDOM_BUDGETS = (10, 20, 50, 91)  # spec section 9: evaluation budgets 10, 20, 50, |C|
+RANDOM_SEEDS = tuple(range(10))  # spec section 9: seeds 0-9
+TRIAL_FY = 355.0  # N/mm2, spec section 9: the F1 trial section uses w and fy = 355
+
+
+@dataclass(frozen=True)
+class MethodResult:
+    status: str  # "feasible" or "abstain"
+    index: int  # position in the mass-ordered catalogue C, -1 if abstain
+    calls: int  # checker calls (section evaluations) made by the search
+
+
+class CountingChecker:
+    """Wraps a Checker and counts checker calls (section evaluations) per context evaluation. Attribute
+    lookups delegate to the wrapped checker."""
+
+    def __init__(self, checker):
+        self._checker = checker
+        self.invocations = 0  # evaluate_context calls
+        self.sections = 0  # section evaluations (the cost unit of spec section 10)
+
+    def evaluate_context(self, ctx, idx=None):
+        self.invocations += 1
+        self.sections += len(self) if idx is None else len(np.atleast_1d(np.asarray(idx, dtype=int)))
+        return self._checker.evaluate_context(ctx, idx)
+
+    def __len__(self):
+        return self._checker.n
+
+    def __getattr__(self, name):
+        return getattr(self._checker, name)
+
+
+class _Calls:
+    """Reads the calls made since construction from a CountingChecker (the counter is the source of truth)."""
+
+    def __init__(self, kc):
+        self.kc = kc
+        self.start = kc.sections
+
+    def calls(self):
+        return self.kc.sections - self.start
+
+
+def enumerate(kc, ctx):
+    """Exact reference: lightest feasible section of C, -1 if none (spec section 7 optimum)."""
+    c = _Calls(kc)
+    e = kc.evaluate_context(ctx)
+    opt = int(np.argmax(e["feasible"])) if e["feasible"].any() else -1
+    return MethodResult("feasible" if opt >= 0 else "abstain", opt, c.calls())
+
+
+def ordered_scan(kc, ctx):
+    """Sections in mass order, one evaluation each, stop at the first feasible section (exact: the first
+    feasible section is the lightest). Abstains after the whole catalogue."""
+    c = _Calls(kc)
+    for i in range(len(kc)):
+        if kc.evaluate_context(ctx, [i])["feasible"][0]:
+            return MethodResult("feasible", i, c.calls())
+    return MethodResult("abstain", -1, c.calls())
+
+
+def trial_index(kc, ctx):
+    """First section in mass order with Wpl >= M_Ed / fy, using the superimposed factored UDL w and fy = 355
+    (spec section 9, F1 trial section). The heaviest section is the fallback when nothing is strong enough."""
+    w, _ = ctx.factored_udl()  # kN/m, self-weight excluded
+    need = (w * ctx.span ** 2 / 8.0) * 1e6 / TRIAL_FY  # N mm / (N/mm2) = mm3
+    W = kc.Wpl  # mm3, in mass order
+    i = int(np.argmax(W >= need))
+    return i if W[i] >= need else len(kc) - 1
+
+
+def heuristic(kc, ctx):
+    """Conventional manual design: trial section from the required modulus, up in mass order until feasible,
+    then down while the next-lighter section stays feasible (spec section 9)."""
+    c = _Calls(kc)
+    n = len(kc)
+    j = trial_index(kc, ctx)
+    e = kc.evaluate_context(ctx, [j])
+    while not e["feasible"][0] and j < n - 1:
+        j += 1
+        e = kc.evaluate_context(ctx, [j])
+    if e["feasible"][0]:
+        while j > 0:
+            if not kc.evaluate_context(ctx, [j - 1])["feasible"][0]:
+                break
+            j -= 1
+        return MethodResult("feasible", j, c.calls())
+    return MethodResult("abstain", -1, c.calls())
+
+
+def random_search(kc, ctx, budget, rng):
+    """`budget` distinct sections drawn uniformly without replacement; the lightest feasible among them is
+    output, -1 if none. Budget |C| evaluates every section (equals enumeration for every seed)."""
+    c = _Calls(kc)
+    n = len(kc)
+    idx = rng.choice(n, size=min(budget, n), replace=False)
+    ok = idx[kc.evaluate_context(ctx, idx)["feasible"]]
+    if len(ok):
+        opt = int(ok.min())  # smallest mass-order position = lightest feasible section found
+        return MethodResult("feasible", opt, c.calls())
+    return MethodResult("abstain", -1, c.calls())
diff --git a/src/ub_rl/runstore.py b/src/ub_rl/runstore.py
new file mode 100644
index 0000000..70df6e0
--- /dev/null
+++ b/src/ub_rl/runstore.py
@@ -0,0 +1,116 @@
+"""P7 run infrastructure (spec section 12): result store and single-thread timing harness.
+
+Every result file is a CSV with a sidecar `*_meta.json` (the CSV name plus `_meta.json`). The meta carries
+`status: "complete"`, the commit, the SHA-256 of the environment file (`src/ub_rl/checker.py` until the
+environments exist, P10), the catalogue and split SHA-256, the hardware and the single-thread limits.
+A result file whose meta file is missing or whose status is not "complete" is rejected when loaded.
+
+`limit_threads()` sets the BLAS/OpenMP thread env vars to 1 before numpy is imported; `hardware_info()`
+records what the machine is. Generated results are never committed (`results/` is ignored)."""
+import csv
+import json
+import os
+import platform
+import sys
+from pathlib import Path
+
+
+class ResultStoreError(Exception):
+    pass
+
+
+REQUIRED_META = ("status", "method", "commit", "environment_file", "environment_sha256", "catalogue_sha256",
+                 "split_file", "split_sha256", "n_contexts")
+
+THREAD_ENV_VARS = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS",
+                   "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS")
+
+
+def limit_threads(n=1):
+    """Pin the linear-algebra thread count to n. Call before importing numpy (spec section 10: search and
+    inference run on a single CPU thread)."""
+    for name in THREAD_ENV_VARS:
+        os.environ.setdefault(name, str(n))
+    return {name: os.environ.get(name) for name in THREAD_ENV_VARS}
+
+
+def hardware_info():
+    """One dict describing the machine, for the `*_meta.json` files. Read-only, no imports of numpy."""
+    cpu_model = platform.processor() or ""
+    if sys.platform.startswith("linux"):
+        try:
+            with open("/proc/cpuinfo") as f:
+                for line in f:
+                    if line.startswith("model name"):
+                        cpu_model = line.split(":", 1)[1].strip()
+                        break
+        except OSError:
+            pass
+    memory_gb = ""
+    try:
+        page, pages = os.sysconf("SC_PAGE_SIZE"), os.sysconf("SC_PHYS_PAGES")
+        memory_gb = round(page * pages / 1e9, 1)
+    except (ValueError, OSError):
+        pass
+    return {
+        "platform": platform.platform(),
+        "system": platform.system(),
+        "machine": platform.machine(),
+        "processor": platform.processor() or "",
+        "cpu_model": cpu_model,
+        "cpu_count": os.cpu_count(),
+        "memory_gb": memory_gb,
+        "python": platform.python_version(),
+    }
+
+
+def meta_name(path):
+    return str(path) + "_meta.json"
+
+
+def _check_meta(path, meta):
+    for key in REQUIRED_META:
+        if key not in meta:
+            raise ResultStoreError(f"meta for {Path(path).name} is missing required key {key!r}")
+    if meta.get("status") != "complete":
+        raise ResultStoreError(f"refusing to write {Path(path).name}: status is {meta['status']!r}, not 'complete'")
+
+
+def write_meta(path, meta):
+    """Write a meta sidecar alone (used for non-CSV result files such as run summaries)."""
+    _check_meta(path, meta)
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    with open(meta_name(path), "w", encoding="ascii", newline="\n") as f:
+        json.dump(meta, f, indent=2)
+        f.write("\n")
+
+
+def write_results(path, rows, columns, meta):
+    """Write a result CSV and its meta sidecar together. The meta must already carry `status: "complete"` and
+    every REQUIRED_META key."""
+    path = Path(path)
+    _check_meta(path, meta)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", newline="", encoding="ascii") as f:
+        wr = csv.DictWriter(f, fieldnames=columns, lineterminator="\n")
+        wr.writeheader()
+        wr.writerows(rows)
+    write_meta(path, meta)
+
+
+def load_results(path):
+    """(rows, meta) of a stored result. A result file without its meta file is rejected; so is a meta whose
+    status is not "complete" or that misses a required key (spec section 12)."""
+    path = Path(path)
+    mp = Path(meta_name(path))
+    if not mp.exists():
+        raise ResultStoreError(f"{path.name} without its meta file {mp.name} is rejected")
+    meta = json.loads(mp.read_text(encoding="ascii"))
+    if meta.get("status") != "complete":
+        raise ResultStoreError(f"{path.name} is rejected: meta status is {meta.get('status')!r}, not 'complete'")
+    for key in REQUIRED_META:
+        if key not in meta:
+            raise ResultStoreError(f"{path.name} is rejected: meta is missing required key {key!r}")
+    with open(path, newline="", encoding="ascii") as f:
+        rows = list(csv.DictReader(f))
+    return rows, meta
diff --git a/tests/test_baselines1.py b/tests/test_baselines1.py
new file mode 100644
index 0000000..440f94c
--- /dev/null
+++ b/tests/test_baselines1.py
@@ -0,0 +1,220 @@
+"""P7: Stage 1 baselines (enumeration, ordered scan, heuristic iteration, random search), checker-call
+accounting and the result store (spec section 12). Acceptance criteria: enumeration equals ordered scan;
+call counts are logged per method; a result file without its meta file is rejected. Skips without the
+workbook; samples the split files so the suite stays fast (the full run is scripts/run_baselines1.py)."""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from ub_rl import baselines
+from ub_rl import splits as S
+from ub_rl.checker import Checker
+from ub_rl.runstore import (REQUIRED_META, ResultStoreError, hardware_info, limit_threads, load_results,
+                            write_results)
+
+ROOT = Path(__file__).resolve().parent.parent
+SPLITS = ROOT / "data" / "splits"
+FILES = ["train", "val", "test_t1", "test_t2", "test_t3", "test_t4", "test_t5", "v12_substudy", "reference"]
+N_SAMPLE = 10  # first N contexts per file, plus every reference context
+
+
+@pytest.fixture(scope="module")
+def kc(C):
+    return baselines.CountingChecker(Checker(C))
+
+
+@pytest.fixture(scope="module")
+def sample_contexts():
+    out = []
+    for name in FILES:
+        _, ctxs = S.load_split(name, root=SPLITS)
+        out.extend(ctxs[:N_SAMPLE])
+    return out
+
+
+def _sections(kc):
+    return kc.sections
+
+
+def _recheck(kc, ctx, res):
+    """Fresh checker call on the output design, as the run script does (spec section 9: verify, 1 call)."""
+    if res.index < 0:
+        return True
+    return bool(kc.evaluate_context(ctx, [res.index])["feasible"][0]) == (res.status == "feasible")
+
+
+# ---------------------------------------------------------------- the four methods
+def test_enumeration_equals_ordered_scan_on_sample_contexts(kc, sample_contexts):
+    for ctx in sample_contexts:
+        e = baselines.enumerate(kc, ctx)
+        s = baselines.ordered_scan(kc, ctx)
+        assert (e.status, e.index) == (s.status, s.index)
+        # independent route: the checker's own lightest-feasible lookup
+        assert s.index == kc.lightest_feasible_context(ctx)
+
+
+def test_random_search_budget_full_equals_enumeration(kc, sample_contexts):
+    for ctx in sample_contexts:
+        e = baselines.enumerate(kc, ctx)
+        for seed in (0, 1):
+            r = baselines.random_search(kc, ctx, len(kc), np.random.default_rng(seed))
+            assert (r.status, r.index) == (e.status, e.index)
+
+
+def test_heuristic_and_random_outputs_feasible_when_claimed_and_rechecked(kc, sample_contexts):
+    for ctx in sample_contexts:
+        h = baselines.heuristic(kc, ctx)
+        assert _recheck(kc, ctx, h)
+        for budget in baselines.RANDOM_BUDGETS:
+            r = baselines.random_search(kc, ctx, budget, np.random.default_rng(0))
+            assert _recheck(kc, ctx, r)
+            if r.index >= 0:  # never lighter than the enumeration optimum (the global optimum)
+                assert kc.mass[r.index] >= kc.mass[baselines.enumerate(kc, ctx).index]
+
+
+def test_call_accounting_matches_counter(kc, sample_contexts):
+    n = len(kc)
+    for ctx in sample_contexts:
+        before = _sections(kc)
+        e = baselines.enumerate(kc, ctx)
+        assert e.calls == n == _sections(kc) - before  # all |C| sections evaluated
+        before = _sections(kc)
+        s = baselines.ordered_scan(kc, ctx)
+        assert s.calls == (s.index + 1 if s.index >= 0 else n) == _sections(kc) - before
+        before = _sections(kc)
+        h = baselines.heuristic(kc, ctx)
+        assert 1 <= h.calls <= n and h.calls == _sections(kc) - before
+        for budget in baselines.RANDOM_BUDGETS:
+            before = _sections(kc)
+            r = baselines.random_search(kc, ctx, budget, np.random.default_rng(3))
+            assert r.calls == min(budget, n) == _sections(kc) - before
+
+
+def test_counting_checker_counts_sections_and_delegates(kc, C):
+    ctx = S.row_to_context(S.load_split("reference", root=SPLITS)[0][0])
+    assert len(kc) == len(C)
+    before = _sections(kc)
+    kc.evaluate_context(ctx)  # whole catalogue
+    assert _sections(kc) - before == len(C)
+    before = _sections(kc)
+    kc.evaluate_context(ctx, [7])
+    kc.evaluate_context(ctx, np.array([1, 2, 3]))
+    assert _sections(kc) - before == 4
+    assert kc.mass is not None and kc.Wpl.shape == (len(C),) and kc.cat.names[0]  # attribute delegation
+
+
+def test_trial_index_is_first_section_with_required_wpl(kc, sample_contexts):
+    need_355 = baselines.TRIAL_FY
+    for ctx in sample_contexts:
+        w, _ = ctx.factored_udl()
+        need = (w * ctx.span ** 2 / 8.0) * 1e6 / need_355
+        t = baselines.trial_index(kc, ctx)
+        W = kc.Wpl
+        if W[t] >= need:
+            assert t == 0 or W[t - 1] < need  # first section in mass order with Wpl >= M_Ed / 355
+        else:
+            assert t == len(kc) - 1  # fallback: the heaviest section
+
+
+def test_random_search_deterministic_per_seed(kc):
+    ctx = S.load_split("val", root=SPLITS)[1][0]
+    a = baselines.random_search(kc, ctx, 20, np.random.default_rng(5))
+    b = baselines.random_search(kc, ctx, 20, np.random.default_rng(5))
+    assert (a.status, a.index, a.calls) == (b.status, b.index, b.calls)
+
+
+# ---------------------------------------------------------------- the result store
+def _meta(tmp_path, **over):
+    m = {"status": "complete", "method": "enumeration", "commit": "abc1234", "environment_file": "src/ub_rl/checker.py",
+         "environment_sha256": "e" * 64, "catalogue_sha256": "c" * 64, "split_file": "data/splits/val.csv",
+         "split_sha256": "s" * 64, "n_contexts": 2}
+    m.update(over)
+    return m
+
+
+def _rows():
+    return [{"id": "val-00000", "method": "enumeration", "status": "feasible", "calls": "91"},
+            {"id": "val-00001", "method": "enumeration", "status": "abstain", "calls": "91"}]
+
+
+def test_runstore_roundtrip(tmp_path):
+    p = tmp_path / "enum_val.csv"
+    write_results(p, _rows(), list(_rows()[0]), _meta(tmp_path))
+    rows, meta = load_results(p)
+    assert rows == _rows() and meta["status"] == "complete" and meta["environment_sha256"] == "e" * 64
+
+
+def test_result_file_without_meta_is_rejected(tmp_path):
+    p = tmp_path / "enum_val.csv"
+    write_results(p, _rows(), list(_rows()[0]), _meta(tmp_path))
+    (tmp_path / "enum_val.csv_meta.json").unlink()
+    with pytest.raises(ResultStoreError, match="without its meta file"):
+        load_results(p)
+
+
+def test_meta_must_be_complete_and_carry_required_keys(tmp_path):
+    p = tmp_path / "enum_val.csv"
+    with pytest.raises(ResultStoreError, match="not 'complete'"):
+        write_results(p, _rows(), list(_rows()[0]), _meta(tmp_path, status="running"))
+    with pytest.raises(ResultStoreError, match="missing required key"):
+        write_results(p, _rows(), list(_rows()[0]), {k: v for k, v in _meta(tmp_path).items() if k != "commit"})
+    assert set(REQUIRED_META) == {"status", "method", "commit", "environment_file", "environment_sha256",
+                                  "catalogue_sha256", "split_file", "split_sha256", "n_contexts"}
+    # a meta written with status "complete" but edited afterwards is rejected at load time too
+    write_results(p, _rows(), list(_rows()[0]), _meta(tmp_path))
+    mp = tmp_path / "enum_val.csv_meta.json"
+    mp.write_text(json.dumps({**_meta(tmp_path), "status": "running"}), encoding="ascii")
+    with pytest.raises(ResultStoreError, match="not 'complete'"):
+        load_results(p)
+
+
+def test_hardware_info_and_single_thread_limits():
+    hw = hardware_info()
+    for key in ("platform", "system", "machine", "cpu_model", "cpu_count", "python"):
+        assert hw[key] not in (None, "")
+    threads = limit_threads()
+    assert all(v == "1" for v in threads.values())
+
+
+# ---------------------------------------------------------------- the run script, end to end
+def test_run_baselines1_smoke(tmp_path, raw_path):
+    """Run the real script on a small limit: acceptance assertions inside the script, files and metas written,
+    enumeration == ordered scan in the stored files, and the store reloads them."""
+    out = tmp_path / "b1"
+    script = ROOT / "scripts" / "run_baselines1.py"
+    proc = subprocess.run([sys.executable, str(script), str(raw_path), "--limit", "3", "--out", str(out)],
+                          capture_output=True, text=True, cwd=ROOT)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert "enumeration == ordered scan on every context: True" in proc.stdout
+
+    summary = json.loads((out / "run_summary.json").read_text(encoding="ascii"))
+    assert summary["status" if "status" in summary else "n_contexts_total"]  # runs to completion
+    assert summary["enum_equals_ordered_scan_overall"] is True
+    assert sum(f["n"] for f in summary["files"]) == summary["n_contexts_total"]
+
+    for name in FILES:
+        enum_rows, enum_meta = load_results(out / f"enumeration_{name}.csv")
+        scan_rows, scan_meta = load_results(out / f"ordered_scan_{name}.csv")
+        assert len(enum_rows) == len(scan_rows) == min(3, len(S.load_split(name, root=SPLITS)[0]))
+        assert enum_meta["environment_sha256"] == S.sha256_file(ROOT / "src/ub_rl/checker.py")
+        assert scan_meta["status"] == "complete" and "hardware" in scan_meta and "cpu_model" in scan_meta["hardware"]
+        for a, b in zip(enum_rows, scan_rows):
+            assert (a["status"], a["section_index"]) == (b["status"], b["section_index"])
